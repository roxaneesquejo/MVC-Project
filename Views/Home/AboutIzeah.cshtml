@{
    ViewData["Title"] = "About Izeah";
}

@section Styles {
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/aboutizeah.css" asp-append-version="true" />
}

<div class="about-izeah container py-5">
    <section class="pb-4 border-bottom">
        <p class="mb-0 about-dim">// about me start</p>
        <h1 class="display-5 fw-bold">Izeah Arquillano</h1>
        <h2 class="h5">Student at PUP Manila</h2>
        <p class="col-md-8 px-0">I like to build and implement simple but interesting solutions to problems.</p>
        <div class="d-flex flex-wrap gap-2 mt-3">
            <a class="btn btn-warning fw-bold" href="#projects">Goto Projects</a>
            <a class="btn btn-outline-light" href="#contact">Contacts</a>
        </div>
    </section>

    <section class="row g-3 mt-4">
        <div class="col-md-7">
            <div class="about-card h-100">
                <h3>about_me.tar.gz</h3>
                <p>I'm Izeah an aspiring software dev from PUP Manila. I'm currently interested in building apps, webapps, game development, reproducible systems, and self-hosting servers</p>
                <ul class="list-unstyled mb-0 small">
                    <li><span class="about-dim">location:</span> Quezon City, Philippines</li>
                    <li><span class="about-dim">interests:</span> android apps, web apps, linux, nix, proxmox, docker, godot</li>
                </ul>
            </div>
        </div>
        <div class="col-md-5">
            <div class="about-card h-100">
                <h3>tech_stack.db</h3>
                <h4>web-related</h4>
                <p>
                    <span class="badge about-badge">HTML/CSS</span>
                    <span class="badge about-badge">JS</span>
                    <span class="badge about-badge">Bootstrap</span>
                    <span class="badge about-badge">Next.js</span>
                    <span class="badge about-badge">Tailwind</span>
                </p>
                <h4>languages</h4>
                <p>
                    <span class="badge about-badge">C/C++</span>
                    <span class="badge about-badge">Python</span>
                    <span class="badge about-badge">Java</span>
                </p>
                <h4>tools &amp; data</h4>
                <p class="mb-0">
                    <span class="badge about-badge">PostgreSQL</span>
                    <span class="badge about-badge">Supabase</span>
                    <span class="badge about-badge">Git</span>
                    <span class="badge about-badge">Linux</span>
                    <span class="badge about-badge">Docker</span>
                    <span class="badge about-badge">Vim/Neovim</span>
                    <span class="badge about-badge">CI/CD</span>
                </p>
            </div>
        </div>
    </section>
</div>
