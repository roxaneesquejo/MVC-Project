@{
    ViewData["Title"] = "About Izeah";
}
@model MVC_Project.Models.IzeahModel

@section Styles {
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/izeahportfolio.css" asp-append-version="true" />
}

<div class="about-izeah container py-5">
    <section class="pb-4 border-bottom">
        <p class="mb-0 about-dim">// about me start</p>
        <h1 class="display-5 fw-bold">Izeah Arquillano</h1>
        <h2 class="h5">Student at PUP Manila</h2>
        <p class="col-md-8 px-0">I like to build and implement simple but interesting solutions to problems.</p>
        <div class="d-flex flex-wrap gap-2 mt-3">
            <a class="btn btn-warning fw-bold" href="#projects">Goto Projects</a>
            <a class="btn btn-outline-light" href="#contact">Contacts</a>
        </div>
    </section>

    <section class="row g-3 mt-4">
        <div class="col-md-7">
            <div class="about-card h-100">
                <h3>about_me.tar.gz</h3>
                <p>I'm Izeah an aspiring software dev from PUP Manila. I'm currently interested in building apps, webapps, game development, reproducible systems, and self-hosting servers</p>
                <ul class="list-unstyled mb-0 small">
                    <li><span class="about-dim">location:</span> Quezon City, Philippines</li>
                    <li><span class="about-dim">interests:</span> @string.Join(", ", Model.Interests?? [])</li>
                </ul>
            </div>
        </div>
        <div class="col-md-5">
            <div class="about-card h-100">
                <h3>tech_stack.db</h3>
                @foreach (var techdomain in Model.TechStack?? [])
                {
                    <h4>@techdomain.Name</h4>
                    <p>
                        @foreach (var item in techdomain.Items)
                        {
                            <span class="badge about-badge">@item</span>
                        }
                    </p>
                }
            </div>
        </div>
    </section>

    <section id="projects" class="mt-5">
        <h3 class="about-dim">~/featured-projects</h3>
        <div class="row g-3">
            @foreach (var project in Model.Projects?? [])
            {
                <div class="col-md-4">
                    <div class="about-card h-100">
                        <h4>@project.Name</h4>
                        <p class="small">@project.Desc</p>
                        <a href="@project.Link">github →</a>
                    </div>
                </div>
            }
        </div>
    </section>

    <section class="mt-5">
        <h3 class="about-dim">~/experience.log</h3>
        @foreach (var experience in Model.Experiences?? [])
        {
            <div class="about-item mb-3">
                <small class="about-dim">@experience.Placement</small>
                <h4>@experience.Name</h4>
                <p class="small mb-0">@experience.Desc</p>
            </div>
        }
    </section>

    <section id="contact" class="mt-5 p-4 border rounded">
        <h3 class="about-dim">~/contact.sh</h3>
        <div class="d-flex flex-wrap gap-2">
            <a class="btn btn-warning fw-bold" href="mailto:izeaharquillano@gmail.com">izeaharquillano@gmail.com</a>
            <a class="btn btn-outline-light" href="https://github.com/izeaharquillano" target="_blank" rel="noopener">GitHub</a>
            <a class="btn btn-outline-light" href="https://www.linkedin.com/in/izeah-arquillano" target="_blank" rel="noopener">LinkedIn</a>
        </div>
    </section>
</div>
