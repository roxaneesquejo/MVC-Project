@{
    ViewData["Title"] = "About Izeah";
}
@model MVC_Project.Models.IzeahModel

@section Styles {
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/izeahportfolio.css" asp-append-version="true" />
}

<div class="about-izeah container py-5">
    <section class="pb-4 border-bottom">
        <p class="mb-0 about-dim">// about me start</p>
        <h1 class="display-5 fw-bold">Izeah Arquillano</h1>
        <h2 class="h5">Student at PUP Manila</h2>
        <p class="col-md-8 px-0">I like to build and implement simple but interesting solutions to problems.</p>
        <div class="d-flex flex-wrap gap-2 mt-3">
            <a class="btn btn-warning fw-bold" href="#projects">Goto Projects</a>
            <a class="btn btn-outline-light" href="#contact">Contacts</a>
        </div>
    </section>

    <section class="row g-3 mt-4">
        <div class="col-md-7">
            <div class="about-card h-100">
                <h3>about_me.tar.gz</h3>
                <p>I'm Izeah an aspiring software dev from PUP Manila. I'm currently interested in building apps, webapps, game development, reproducible systems, and self-hosting servers</p>
                <ul class="list-unstyled mb-0 small">
                    <li><span class="about-dim">location:</span> Quezon City, Philippines</li>
                    <li><span class="about-dim">interests:</span> @string.Join(", ", Model.Interests?? [])</li>
                </ul>
            </div>
        </div>
        <div class="col-md-5">
            <div class="about-card h-100">
                <h3>tech_stack.db</h3>
                <h4>web-related</h4>
                <p>
                    <span class="badge about-badge">HTML/CSS</span>
                    <span class="badge about-badge">JS</span>
                    <span class="badge about-badge">Bootstrap</span>
                    <span class="badge about-badge">Next.js</span>
                    <span class="badge about-badge">Tailwind</span>
                </p>
                <h4>languages</h4>
                <p>
                    <span class="badge about-badge">C/C++</span>
                    <span class="badge about-badge">Python</span>
                    <span class="badge about-badge">Java</span>
                </p>
                <h4>tools &amp; data</h4>
                <p class="mb-0">
                    <span class="badge about-badge">PostgreSQL</span>
                    <span class="badge about-badge">Supabase</span>
                    <span class="badge about-badge">Git</span>
                    <span class="badge about-badge">Linux</span>
                    <span class="badge about-badge">Docker</span>
                    <span class="badge about-badge">Vim/Neovim</span>
                    <span class="badge about-badge">CI/CD</span>
                </p>
            </div>
        </div>
    </section>

    <section id="projects" class="mt-5">
        <h3 class="about-dim">~/featured-projects</h3>
        <div class="row g-3">
            <div class="col-md-4">
                <div class="about-card h-100">
                    <h4>Aya</h4>
                    <p class="small">An app that helps answer the question "saan tayo?" using group preference-based matching algorithms.</p>
                    <a href="https://github.com/afkDen/iNet_GitHub">github →</a>
                </div>
            </div>
            <div class="col-md-4">
                <div class="about-card h-100">
                    <h4>Starship</h4>
                    <p class="small">A system that aims to solve the fractured data problem of rural schools using sms-based data collection</p>
                    <a href="https://github.com/star-ship-project/starship-web">github →</a>
                </div>
            </div>
            <div class="col-md-4">
                <div class="about-card h-100">
                    <h4>PUPili</h4>
                    <p class="small">An offline-first lagoon food database with a live interactive map utilizing b-tree lookups for its database engine</p>
                    <a href="https://github.com/izeaharquillano/pup-lagoon-app">github →</a>
                </div>
            </div>
        </div>
    </section>

    <section class="mt-5">
        <h3 class="about-dim">~/experience.log</h3>
        <div class="about-item">
            <small class="about-dim">1st Runner-Up</small>
            <h4>DOST START Hackathon</h4>
            <p class="small mb-0">Built and presented Starship as a backend developer</p>
        </div>
        <div class="about-item mt-3">
            <small class="about-dim">6th Place</small>
            <h4>SIKAPTala DLSU Hackathon</h4>
            <p class="small mb-0">Built and contributed to Aya</p>
        </div>
    </section>

    <section id="contact" class="mt-5 p-4 border rounded">
        <h3 class="about-dim">~/contact.sh</h3>
        <div class="d-flex flex-wrap gap-2">
            <a class="btn btn-warning fw-bold" href="mailto:izeaharquillano@gmail.com">izeaharquillano@gmail.com</a>
            <a class="btn btn-outline-light" href="https://github.com/izeaharquillano" target="_blank" rel="noopener">GitHub</a>
            <a class="btn btn-outline-light" href="https://www.linkedin.com/in/izeah-arquillano" target="_blank" rel="noopener">LinkedIn</a>
        </div>
    </section>
</div>
