@{
    ViewData["Title"] = "About Roxane";
}
@using MVC_Project.Models
@model PortfolioModel

<div class = "portfolio-container">
    <div class = "personal-info-container">
        <img src="@Url.Content(Model.photoLink)" alt="Roxane Graduation Picture" id="rox-grad-pic">
        
        <div class = "personal-details">
            <h1>@Model.firstName @Model.middleName @Model.lastName</h1>
            <p>@Model.bio</p>
            <div class = "social-links">
                <a href="@Model.githubLink">Github</a>    
                <a href="@Model.linkedinLink">Linkedin</a> 
                <a href="mailto:@Model.emailAddress">Email</a>   
            </div>
        </div>
    </div>

    <div class = "education-container">
        <h2>Education</h2>
        <div class = "undergraduate-studies">
            <h5>@Model.university</h5>
            <p>@Model.yearLevel Year @Model.degree Student</p>
        </div>
    </div>

    <div class = "techstack-container">
        <h1>Tech Stack</h1>
        @foreach (String tech in Model.techStack)
        {
            @tech @:
        }
    </div>

    <div class = "experience-container">
        @foreach (Experience experience in Model.Experiences)
        {   
            <div class = "experience-card">
                <h3>@experience.company</h3>
                <p>@experience.position</p>
                <p>@experience.startDate</p>
                <p>@experience.endDate</p>
                <p>@experience.description</p>
            </div>
        }
    </div>

    <div class = "project-container">
        <h2>Projects</h2>
        @foreach (Project project in Model.Projects)
        {
            <div class = "project-card">
                <h3>@project.name</h3>
                
                @foreach (String tool in project.tools)
                {
                    @tool @:
                }

                <p>@project.description</p>
                <a href = "@project.projectLink">Link</a>
            </div>

        }
    </div>

</div>