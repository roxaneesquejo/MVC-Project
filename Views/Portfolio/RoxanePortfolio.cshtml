@{
    ViewData["Title"] = "About Roxane";
}
@using MVC_Project.Models
@model PortfolioModel

<div class = "portfolio-container">
    <div class = "personal-details light-container">
        <h1>@Model.firstName @Model.middleName @Model.lastName</h1>
            <p>For there is magic in programming.</p>
            

        <div class = "social-links">
            <a href="@Model.githubLink">Github</a>    
            <a href="@Model.linkedinLink">Linkedin</a> 
            <a href="mailto:@Model.emailAddress">Email</a>   
        </div>
    </div>

    <div class = "about-me-container dark-container">

        <img src="@Url.Content(Model.photoLink)" alt="Roxane Graduation Picture" id="rox-grad-pic">
        <div class = "about-card">
            <h1>About Me</h1>
            <p>@Model.bio</p>
            <div class = "about-subheading">
                <div class = "based-subheading">
                    <span class = "title">Based in</span>
                    <span>@Model.location</span>
                </div>
                <div class = "based-subheading">
                    <span class = "title">Status</span>
                    <span>@Model.status</span>
                </div>
                
            </div>
        </div>
        
        @* <div class = "technologies-container">
            <h1>Technologies</h1>

                @foreach (Technologies tech in Model.TechStack)
                {
                    <div class = "tools-container">
                        <h5>@tech.category</h5>
                        <p>
                            @foreach (String technology in @tech.tool)
                            {
                                @technology @:
                            }
                        </p>
                    </div>
                }
        </div> *@
    </div>

    

    <div class = "experience-container light-container">
        <h1>Experience</h1>
        @foreach (Experience experience in Model.Experiences)
        {   
            <div class = "experience-card">
                <h5>@experience.company</h5>
                <p>@experience.position | @experience.startDate - @experience.endDate</p>
                <p>@experience.description</p>
            </div>
        }
    </div>

    <div class = "project-container dark-container">
        <h1>Projects</h1>

        <div class = "projects-grid">
            @foreach (Project project in Model.Projects)
            {
                <div class = "project-card">
                    <h4>@project.name</h4>
                    
                    <div class="tool-container">
                        @foreach (String tool in project.tools)
                        {
                            <span class="tool-indiv">@tool</span>
                        }
                    </div>

                    <p>@project.description</p>
                    <a href = "@project.projectLink">Link</a>
                </div>
            }
        </div>
    </div>

</div>