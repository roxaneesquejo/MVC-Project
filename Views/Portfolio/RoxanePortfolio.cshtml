@{
    ViewData["Title"] = "About Roxane";
}
@using MVC_Project.Models
@model PortfolioModel

<nav id ="portfolio-navbar" class="hidden-navbar">
    <a href="#about-section">About</a>
    <a href="#experience-section">Experience</a>
    <a href="#project-section">Projects</a>
    <a href="#contact-section">Contact</a>
</nav>

<div class = "portfolio-container">
    <div class = "personal-details light-container">
        <h1>@Model.firstName @Model.middleName @Model.lastName</h1>
            <p>For there is magic in programming.</p>

        <div class = "button-links">
            <a href="#about-section">Explore Profile</a>    
            <a href="@Url.Content(Model.resumeLink)" download>Download Resume</a>   
        </div>
    </div>

    <div id = "about-section" class = "about-me-container dark-container">

        <img src="@Url.Content(Model.photoLink)" alt="Roxane Graduation Picture" id="rox-grad-pic">
        <div class = "about-card">
            <h1>About Me</h1>
            <p>@Model.bio</p>
            <div class = "about-subheading">
                <div class = "based-subheading">
                    <span class = "title">Based in</span>
                    <span>@Model.location</span>
                </div>
                <div class = "based-subheading">
                    <span class = "title">Status</span>
                    <span>@Model.status</span>
                </div>
                
            </div>
        </div>
    </div>

    <div id ="experience-section" class = "experience-container light-container">
        <h1>Experience</h1>
        @foreach (Experience experience in Model.Experiences)
        {   
            <div class = "experience-card">
                <h4>@experience.company</h4>
                <p>@experience.position | @experience.startDate - @experience.endDate</p>
                <p>@experience.description</p>
            </div>
        }
    </div>

    <div id = "project-section" class = "project-container dark-container">
        <h1>Highlighted Projects</h1>

        <div class = "projects-grid">
            @foreach (Project project in Model.Projects)
            {
                <div class = "project-card">
                    <h4>@project.name</h4>
                    
                    <div class="tool-container">
                        @foreach (String tool in project.tools)
                        {
                            <span class="tool-indiv">@tool</span>
                        }
                    </div>

                    <p>@project.description</p>
                    <a href = "@project.projectLink">Link</a>
                </div>
            }
        </div>
    </div>

    <div class = "techstack-container light-container">
        <h1>Technical Skills</h1>
           <div class = "tech-grid">
                @foreach (Technologies tech in Model.TechStack)
                {
                <div class = "tech-card">
                    <h5>@tech.category</h5>
                    <div class = "tool-container">
                        @foreach (String technology in @tech.tool)
                        {
                            <span class = "tech-indiv">@technology</span>
                        }
                    </div>
                </div>
                }
           </div>
    </div>

     <div id = "contact-section" class = "contact-container dark-container">
        <h1>Get In Touch</h1>            
        <p>Reach out to me through the following:</p>

        <div class = "button-links">
            <a href="@Model.githubLink">Github</a>    
            <a href="@Model.linkedinLink">Linkedin</a> 
            <a href="mailto:@Model.emailAddress">Email</a>   
        </div>
    </div>

</div>